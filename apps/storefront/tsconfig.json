{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "isolatedModules": true,
    "types": ["vite/client"], "paths": {"@shared/*": ["../web-shared/*"]}
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../web-shared/**/*.ts"]
}
