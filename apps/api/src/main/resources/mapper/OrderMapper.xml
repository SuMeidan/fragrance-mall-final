<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.scent.order.OrderMapper">
  <sql id="filters">
    <where>
      <if test="owner != null">account_id=#{owner}</if>
      <if test="status != null">AND status=#{status}</if>
    </where>
  </sql>
  <select id="find" resultType="io.scent.order.Order">
    SELECT * FROM mall_order WHERE id=#{id}<if test="owner != null"> AND account_id=#{owner}</if>
  </select>
  <select id="lock" resultType="io.scent.order.Order">
    SELECT * FROM mall_order WHERE id=#{id}<if test="owner != null"> AND account_id=#{owner}</if> FOR UPDATE
  </select>
  <select id="list" resultType="io.scent.order.Order">
    SELECT o.*,(SELECT SUM(quantity) FROM order_item i WHERE i.order_id=o.id) AS item_count
    FROM mall_order o <include refid="filters"/> ORDER BY id DESC LIMIT #{size} OFFSET #{offset}
  </select>
  <select id="count" resultType="long">
    SELECT COUNT(*) FROM mall_order <include refid="filters"/>
  </select>
</mapper>
