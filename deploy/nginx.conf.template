# Local loopback preview of the production routing model. TLS belongs to a real approved deployment.
worker_processes 1;
pid logs/nginx.pid;
error_log logs/error.log warn;
events { worker_connections 256; }
http {
    include "@@MIME@@";
    default_type application/octet-stream;
    server_tokens off;
    log_format safe '$time_iso8601 $request_method $status $request_time $upstream_http_x_trace_id';
    access_log logs/access.log safe;
    sendfile on;
    keepalive_timeout 20;
    client_max_body_size 64k;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    server {
        listen 127.0.0.1:@@WEB_PORT@@;
        server_name localhost;
        root "@@ROOT@@";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://openapi-sandbox.dl.alipaydev.com" always;
        location = /api/v1/admin/media {
            client_max_body_size 6m;
            proxy_pass http://127.0.0.1:@@API_PORT@@;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 3s;
            proxy_read_timeout 25s;
        }
        location /api/ {
            proxy_pass http://127.0.0.1:@@API_PORT@@;
            proxy_set_header Host $host;
            # Replace client-supplied forwarding headers. Never append an untrusted header.
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 3s;
            proxy_read_timeout 25s;
        }
        location /media/ {
            proxy_pass http://127.0.0.1:@@API_PORT@@;
            proxy_set_header Host $host;
        }
        location /actuator/ { return 404; }
        location /swagger-ui/ { return 404; }
        location /v3/api-docs { return 404; }
        location = /admin { return 302 /admin/; }
        location /admin/ { try_files $uri $uri/ /admin/index.html; expires -1; }
        location ~* "^/(admin/)?assets/[^/]+-[a-z0-9_-]{8,}\.(js|css)$" {
            try_files $uri =404;
            expires 1y;
        }
        location ~* ^/(admin/)?assets/.+\.(png|jpe?g|webp|svg)$ { try_files $uri =404; expires 1h; }
        location / { try_files $uri $uri/ /index.html; expires -1; }
    }
}
